<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Mt.App.MainWindow"
        Title="ked-motion-tool"
        Width="1280" Height="800"
        WindowStartupLocation="CenterScreen">
    <!-- M0: 빈 창. M2에서 그래프 편집기, M3에서 뷰포트, M4에서 도프 시트가 이 자리에 들어온다 (PLAN §5). -->
    <DockPanel>
        <TextBlock DockPanel.Dock="Top"
                   x:Name="StatusText"
                   Margin="12,8"
                   Opacity="0.7"
                   Text="ked-motion-tool — M0 뼈대. 아직 열 문서가 없다." />
        <Border />
    </DockPanel>
</Window>
