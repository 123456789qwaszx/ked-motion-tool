<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Mt.App.MainWindow"
        Title="ked-motion-tool"
        Width="1400" Height="860"
        MinWidth="960" MinHeight="600"
        WindowStartupLocation="CenterScreen">
    <!-- 뼈대만 XAML이다. 내용은 MainWindow.axaml.cs가 코드로 채운다 — VnTool과 같은 방식.
         왼쪽 · 가운데 · 오른쪽 사이의 스플리터를 끌면 폭이 바뀌고 설정에 남는다. -->
    <DockPanel>
        <StackPanel x:Name="Toolbar" DockPanel.Dock="Top" Orientation="Horizontal" Spacing="6" Margin="8,6" />
        <Border DockPanel.Dock="Bottom" Padding="8,4" BorderThickness="0,1,0,0" BorderBrush="#33888888">
            <StackPanel Spacing="2">
                <TextBlock x:Name="StatusText" FontSize="11" Opacity="0.8" Text="ked-motion-tool" />
                <StackPanel x:Name="ProblemsPanel" Spacing="2" IsVisible="False" />
            </StackPanel>
        </Border>
        <Grid x:Name="Shell" ColumnDefinitions="280,4,*,4,280">
            <ScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="LeftPanel" Margin="8" Spacing="6" />
            </ScrollViewer>
            <GridSplitter Grid.Column="1" ResizeDirection="Columns" Background="Transparent" />
            <Border x:Name="GraphHost" Grid.Column="2" Margin="4" />
            <GridSplitter Grid.Column="3" ResizeDirection="Columns" Background="Transparent" />
            <ScrollViewer Grid.Column="4" HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="RightPanel" Margin="8" Spacing="6" />
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>
