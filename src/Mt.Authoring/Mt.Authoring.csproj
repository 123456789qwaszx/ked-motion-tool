<Project Sdk="Microsoft.NET.Sdk">
  <!-- 모션 저작 도메인. Avalonia를 모른다 — 편집은 전부 명령으로 수렴하고, 그리기는 Mt.App의 몫이다.
       Yarn·커맨드 타입은 여기에 없다 (툴은 커맨드를 모른다). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Mt.Authoring</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Mt.Authoring.Tests" />
  </ItemGroup>
  <ItemGroup>
    <!-- 내장 기본값: 런타임 ExportedTuning의 사본(덤프 없이도 캐릭터 리그가 선다)과 프리팹에서 뽑은 무대 뼈대.
         손으로 고치지 않는다 — 원본 커밋은 BuiltinTuning.Source에 적는다. -->
    <EmbeddedResource Include="Defaults\**\*.json" LogicalName="Defaults/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <!-- 무대 런타임에서 복사 반입한 연출 코어. 모션 규약·수학·검증은 이 한 벌만 쓴다. -->
    <ProjectReference Include="..\Ked.Presentation.Core\Ked.Presentation.Core.csproj" />
  </ItemGroup>
</Project>
